# Firebase (client config) - ver Firebase Console > Configuración del proyecto
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Auth / feature flags — la app interna va con login obligatorio y sin sesiones
# anónimas. El cotizador público se compila con "build:public", que invierte
# estos dos flags por su cuenta.
VITE_REQUIRE_LOGIN=true
VITE_ANON_AUTH=false
VITE_BOOTSTRAP_ADMIN_EMAIL=
VITE_ADMIN_EMAIL=
VITE_ENABLE_PRODUCCION=true
VITE_ENABLE_INVENTARIO=true

# Cloudinary — OBLIGATORIO para subir imágenes.
# Es el único almacén de imágenes de la app: fotos de producto, foto de perfil
# y registro fotográfico de las fichas. No se usa Firebase Storage porque
# activarlo obliga a pasar el proyecto a plan Blaze.
# El preset debe ser de tipo "unsigned" (Settings → Upload → Upload presets).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

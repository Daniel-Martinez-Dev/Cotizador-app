rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Staff autenticado con cuenta real (la auth anónima del cotizador público
    // no debe poder tocar nada de producción).
    function isStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Quién puede tocar una evidencia ya subida: admin o producción. El rol se
    // lee del perfil en Firestore (reglas entre servicios). La planta sube
    // fotos, nunca las quita ni las pisa — igual que en firestore.rules, donde
    // una firma o una entrega ya guardadas son de una sola escritura.
    function puedeCorregirEvidencia() {
      return isStaff() && (
        request.auth.token.email == 'gerenciacchainservices@gmail.com' ||
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid))
          .data.get('roles', []).hasAny(['admin', 'produccion'])
      );
    }

    // Registro fotográfico de una ficha de producción (alistado, revisión,
    // entrega). Las fotos se comprimen en el cliente (ver fotosFicha.js); el
    // tope y el tipo se revalidan aquí porque el cliente no es de fiar.
    match /fichas/{allPaths=**} {
      allow read: if isStaff();
      // `resource == null` es una foto nueva; sobrescribir una que ya está es
      // modificar la evidencia, y eso ya no es de la planta.
      allow write: if isStaff()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (resource == null || puedeCorregirEvidencia());
      allow delete: if puedeCorregirEvidencia();
    }

    // Foto de perfil. Cada quien sube y borra la suya; el resto del staff solo
    // la ve (sale en la barra de la app y en el selector de firmantes). La
    // firma dibujada NO vive aquí: va incrustada en el documento del usuario
    // porque termina dentro de la ficha impresa (ver firmaDibujo.js).
    match /usuarios/{uid}/{archivo=**} {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaff() && (request.auth.uid == uid || puedeCorregirEvidencia());
    }

    match /productos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'gerenciacchainservices@gmail.com';
    }
    // Bundles de actualización OTA — lectura pública, escritura solo admin SDK
    match /updates/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers base ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isStaff() {
      return isSignedIn() && !isAnonymous();
    }

    // ─── Perfil del usuario autenticado ────────────────────────────────────────

    function userRef() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function userExists() {
      return isStaff() && exists(userRef());
    }

    function userDoc() {
      return get(userRef()).data;
    }

    // Usuario con estado "active" en su perfil
    function isActive() {
      return userExists() && userDoc().get('status', 'pending') == 'active';
    }

    // Usuario con un rol específico en su array de roles
    function hasRole(role) {
      return userExists() && userDoc().get('roles', []).hasAny([role]);
    }

    // ─── Admin ─────────────────────────────────────────────────────────────────

    // Admin por email del token (propietario del sistema, siempre activo)
    function isAdminEmail() {
      return isStaff() && request.auth.token.email == 'gerenciacchainservices@gmail.com';
    }

    // Admin por rol en el perfil
    function hasAdminRole() {
      return userExists() && userDoc().get('roles', []).hasAny(['admin']);
    }

    function isAdmin() {
      return isAdminEmail() || (isStaff() && hasAdminRole());
    }

    // ─── Usuario activo (no pendiente) ─────────────────────────────────────────
    // Cualquier staff activo o el admin-email (que no necesita perfil en DB)

    function isActiveStaff() {
      return isAdmin() || (isStaff() && isActive());
    }

    // ─── Roles de planta ───────────────────────────────────────────────────────
    // "empleado": el operario. Ve las fichas, las firma y las cierra. Desde la
    // separación del almacén ya NO toca materia prima.
    // "almacenista": la tablet del cuarto de almacén. Es el único perfil de
    // planta que mueve inventario, y además administra el catálogo de
    // materiales y proveedores (crear y editar; borrar sigue siendo de
    // inventario/admin, porque un material borrado se lleva su historial).

    function isEmpleadoRole() {
      return isActiveStaff() && hasRole('empleado');
    }

    function isAlmacenistaRole() {
      return isActiveStaff() && hasRole('almacenista');
    }

    // Quien trabaja desde la interfaz de planta, sea operario o almacenista:
    // ambos necesitan las fichas (el almacenista, para amarrar cada salida de
    // material a una orden de producción).
    function isPlantaRole() {
      return isEmpleadoRole() || isAlmacenistaRole();
    }

    // Quien puede mover el cuarto de materia prima.
    function isAlmacenStaff() {
      return isAdmin() || (isActiveStaff() && hasRole('inventario')) || isAlmacenistaRole();
    }

    // Quien lleva la facturación y la cartera. Es un rol de oficina y no toca
    // nada de planta; a la inversa, planta no ve un solo peso de la cartera.
    function isContabilidadStaff() {
      return isAdmin() || (isActiveStaff() && hasRole('contabilidad'));
    }

    // Un documento que entró por la importación o la migración del Excel sí se
    // puede borrar para deshacer un lote mal cargado. Una factura digitada en la app no: esa
    // se anula (campo `anulado`), porque un número ya emitido tiene que seguir
    // existiendo.
    function esImportado() {
      return resource.data.get('origen', '') == 'importacion'
          || resource.data.get('origen', '') == 'migracion';
    }

    // Un empleado solo puede tocar notas/estado/firmas/entrega/updatedAt en una
    // ficha, y nunca devolverla a borrador ni a producción.
    //
    // Los dos estados que cierran la ficha exigen su firma: "terminado" la de
    // quién alistó y empacó, "entregado" la de quién revisó y aprobó más la
    // fecha de entrega (ver firmasFicha.js).
    //
    // Y lo firmado no se toca: una firma o una entrega ya guardadas son de una
    // sola escritura para la planta — ni se modifican ni se borran, tampoco su
    // registro fotográfico. Corregirlas es cosa de producción/admin.

    function firmasPrevias() {
      return resource.data.get('firmas', {});
    }

    function firmasNuevas() {
      return request.resource.data.get('firmas', {});
    }

    // La etapa se puede crear, nunca cambiar.
    function firmaEtapaInmutable(etapa) {
      return firmasPrevias().get(etapa, null) == null ||
        firmasNuevas().get(etapa, null) == firmasPrevias().get(etapa, null);
    }

    function firmaEtapaPresente(etapa) {
      return firmasNuevas().get(etapa, {}).get('personas', []).size() > 0;
    }

    function entregaInmutable() {
      return !('entrega' in resource.data) ||
        request.resource.data.entrega == resource.data.entrega;
    }

    function fichaUpdateEmpleadoOk() {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      return diffKeys.hasOnly(['notas', 'estado', 'firmas', 'entrega', 'updatedAt']) &&
        firmaEtapaInmutable('alistado') &&
        firmaEtapaInmutable('revisado') &&
        entregaInmutable() &&
        (!diffKeys.hasAny(['estado']) ||
          (request.resource.data.estado == 'terminado' &&
            firmaEtapaPresente('alistado')) ||
          (request.resource.data.estado == 'entregado' &&
            firmaEtapaPresente('revisado') &&
            request.resource.data.entrega.fecha is string &&
            request.resource.data.entrega.fecha.size() > 0));
    }

    // ─── Cotizaciones ──────────────────────────────────────────────────────────
    // Planta no entra, y esto es una regla del servidor y no de la interfaz:
    // desde que la ficha guarda de qué cotización salió (`cotizacionId`, ver
    // utils/documentoVinculo.js), el operario tiene a la vista el id de un
    // documento con precios. Ese id no le sirve de nada porque aquí se le
    // niega la lectura — antes no, porque `isActiveStaff()` lo incluía y las
    // cotizaciones viejas no traen `uid`. El veto exceptúa al admin
    // porque el `hasRole` de las reglas es literal —no le da paso libre como
    // el de la app— y hay quien es admin y además tiene rol de planta.
    //
    // La oficina sigue como estaba: cada quien ve las suyas y el admin las ve
    // todas. Un vínculo hacia una cotización ajena se muestra por el número
    // que la ficha guardó, pero abrirla sigue pidiendo permiso.
    match /cotizaciones/{cotId} {
      allow read: if isActiveStaff() && (isAdmin() || !isPlantaRole()) && (
        isAdmin() ||
        ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
        !('uid' in resource.data)
      );
      allow create: if isActiveStaff() && (isAdmin() || !isPlantaRole()) && (
        !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isActiveStaff() && (isAdmin() || !isPlantaRole()) && (
        isAdmin() ||
        ('uid' in resource.data && resource.data.uid == request.auth.uid)
      );
    }

    // ─── Perfiles de usuario ───────────────────────────────────────────────────
    //
    // `usuarios/{uid}` es el documento que decide qué puede hacer cada persona:
    // aquí viven `roles` y `status`, y de aquí los leen isAdmin() y hasRole().
    // Por eso el dueño del documento NO puede escribirlos. Si pudiera, y como el
    // registro está abierto (ver signUpWithEmail), cualquiera en internet se
    // crearía una cuenta, se pondría `roles: ['admin']` y tendría el sistema
    // entero: cotizaciones, inventario, producción y cartera.
    //
    // Los roles los asigna un admin, con una sola excepción controlada: el
    // pre-registro por email (ver preRegistroCoincide).

    // Lo único que una persona puede cambiarse a sí misma desde "Mi perfil".
    // Espejo de CAMPOS_PERFIL_PROPIO en src/utils/firebaseUsers.js: si cambia
    // allá, tiene que cambiar aquí — el cliente propone y esta lista dispone.
    function camposPerfilPropio() {
      return ['displayName', 'firstName', 'lastName', 'fotoURL', 'fotoPath',
              'firmaDataUrl', 'updatedAt'];
    }

    function soloTocaSuPerfil() {
      return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(camposPerfilPropio());
    }

    // Un alta normal: sin roles y pendiente de aprobación. Es lo que escriben
    // signUpWithEmail() y el caso "usuario desconocido" de
    // ensureUserProfileForLogin().
    function altaPendiente() {
      return request.resource.data.get('roles', []) == []
          && request.resource.data.get('status', '') == 'pending';
    }

    // El pre-registro por email: un admin deja preparado en
    // `usuarios_email/{clave}` con qué roles entrará alguien que todavía no se
    // ha registrado, y esa persona se los copia a su perfil la primera vez que
    // entra (así no hay que aprobarla a mano).
    //
    // Es la única vía por la que alguien se asigna roles a sí mismo, así que se
    // valida entera contra el servidor. La clave la manda el cliente, pero eso
    // da igual: lo que se compara es el CONTENIDO del documento pre-registrado
    // —que solo un admin pudo escribir— contra el email del token, que el
    // cliente no puede falsificar. Para reclamar unos roles hay que exhibir un
    // pre-registro hecho a nombre del correo con el que se inició sesión.
    function preRegistroRef(clave) {
      return /databases/$(database)/documents/usuarios_email/$(clave);
    }

    function preRegistroCoincide() {
      return claveDePreRegistroValida(request.resource.data.get('preRegistroKey', ''));
    }

    function claveDePreRegistroValida(clave) {
      return clave is string
          && clave.matches('[^/]+')
          && exists(preRegistroRef(clave))
          && get(preRegistroRef(clave)).data.get('email', '') == request.auth.token.email
          && request.resource.data.get('roles', []) == get(preRegistroRef(clave)).data.get('roles', [])
          && request.resource.data.get('status', '') == get(preRegistroRef(clave)).data.get('status', '');
    }

    match /usuarios/{uid} {
      // Lectura: el propio usuario puede ver su perfil (para saber si está pendiente);
      // cualquier staff activo puede listar el directorio (necesario para el
      // selector de firmas de fichas de producción).
      allow read: if isStaff() && (request.auth.uid == uid || isActiveStaff());

      allow create: if isAdmin()
                    || (isStaff() && request.auth.uid == uid
                        && (altaPendiente() || preRegistroCoincide()));

      // El pre-registro solo vale la primera vez, cuando la persona todavía no
      // tiene roles. Después manda `usuarios/{uid}`: si un admin le quita un
      // rol, un pre-registro viejo no puede devolvérselo al siguiente login.
      allow update: if isAdmin()
                    || (isStaff() && request.auth.uid == uid
                        && (soloTocaSuPerfil()
                            || (resource.data.get('roles', []) == []
                                && preRegistroCoincide())));

      allow delete: if isAdmin();
    }

    // Índice por email. Escribir aquí es repartir permisos —es lo que decide con
    // qué roles entra alguien la primera vez—, así que es cosa de admin. Antes
    // era `allow write: if isStaff()`, que dejaba a cualquier registrado
    // pre-registrarse a sí mismo como admin y promoverse al volver a entrar:
    // la misma escalada que cierra el bloque de arriba, por la puerta de al lado.
    match /usuarios_email/{emailKey} {
      // `get` por clave exacta lo necesita cualquiera al iniciar sesión, para
      // leer su propio pre-registro. Listar la colección entera —el directorio
      // de correos y sus roles— es solo de admin.
      allow get: if isStaff();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─── Empresas y Contactos ──────────────────────────────────────────────────
    match /empresas/{empresaId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff();
      allow delete: if isAdmin();

      match /contactos/{contactoId} {
        allow read: if isActiveStaff();
        allow create, update: if isActiveStaff();
        allow delete: if isAdmin();
      }
    }

    // ─── Contadores de numeración ──────────────────────────────────────────────
    //
    // De aquí salen los números que acaban impresos y en manos de otra gente: el
    // de cotización, el de orden de producción y el SKU/código de barras de cada
    // material. Un número ya emitido está en un PDF que el cliente guarda y en
    // una etiqueta pegada a un rollo.
    //
    // Por eso la regla que de verdad importa aquí no es quién escribe, sino que
    // el contador SOLO PUEDA SUBIR. Si alguien lo devuelve a cero —por error o a
    // propósito— la app vuelve a repartir números ya usados, y acabas con dos
    // cotizaciones distintas con el mismo número y dos fichas con la misma orden
    // de producción. Eso no lo arregla ningún rol: el almacenista que reinicia el
    // contador tiene permiso legítimo para tocarlo.
    //
    // El reparto ya se hace con runTransaction() para que dos personas a la vez
    // no se lleven el mismo número (ver firebaseConsecutivos.js). Esto es la otra
    // mitad, la que faltaba del lado del servidor.
    //
    // (Aquí había también /counters y /quoteCounters abiertos a cualquier staff.
    // Se fueron: ningún commit de la historia los ha usado nunca.)

    function contadorNace() {
      return request.resource.data.numero is int
          && request.resource.data.numero > 0;
    }

    function contadorAvanza() {
      return request.resource.data.numero is int
          && request.resource.data.numero > resource.data.get('numero', 0);
    }

    // Cada contador es de quien emite ese documento: cotizar lo hace cualquiera
    // de oficina, numerar materiales es del cuarto de almacén y las órdenes de
    // producción son de producción. Un docId que no esté en la lista solo lo
    // toca un admin — así un contador nuevo entra a mano y no por accidente.
    function esContadorDeProduccion(docId) {
      return docId == 'orden_produccion_global'
          || docId == 'orden_produccion_division';
    }

    function puedeNumerar(docId) {
      return isAdmin()
          || (docId == 'cotizacion' && isActiveStaff())
          || (docId == 'inventario_material' && isAlmacenStaff())
          || (esContadorDeProduccion(docId) && isActiveStaff() && hasRole('produccion'));
    }

    match /consecutivos/{docId} {
      // Leer lo necesita más gente que escribir: la vista previa enseña el
      // próximo número de cotización sin reservarlo (peekNextQuoteNumber), y la
      // transacción del contador global consulta el consecutivo legado de
      // División para no repetir números ya impresos en fichas viejas.
      allow read: if isActiveStaff();

      allow create: if puedeNumerar(docId) && contadorNace();
      allow update: if puedeNumerar(docId) && contadorAvanza();

      // Borrar un contador es reiniciar la numeración por la puerta de atrás:
      // el siguiente en pedir número recibiría el 1.
      //
      // Ojo con el alcance: el catch-all del final de este archivo le concede
      // todo al admin, y en Firestore los permisos SUMAN —ninguna regla puede
      // quitar lo que otra concede—, así que esto ata a todo el mundo menos al
      // admin. Que es justo el reparto que se busca: lo que hay que impedir es
      // que un almacenista o un comercial reinicien la numeración con el permiso
      // legítimo que tienen para tocarla.
      allow delete: if false;
    }

    // ─── Producción: admin o usuario con rol "produccion" ──────────────────────
    match /produccion/{docId} {
      allow read, write: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
    }

    match /produccion/{docId}/{subCol}/{subId} {
      allow read, write: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
    }

    // ─── Fichas de fabricación (División, Sello, Abrigo Retráctil, Puertas
    // Rápidas, Puertas Seccionales): "produccion"/admin tienen acceso total;
    // "empleado" (planta) solo puede leer y actualizar notas/estado/firmas, y
    // lo que firma queda cerrado para él (ver fichaUpdateEmpleadoOk).
    //
    // Contabilidad las LEE, y nada más: es lo que necesita el selector con el
    // que una factura dice qué fichas cubre (ver utils/documentoVinculo.js).
    // Leer una ficha no muestra un solo peso — medidas, materiales y estado—,
    // así que el muro entre planta y cartera sigue en pie: es la factura la
    // que apunta a la ficha, nunca al revés.
    match /division_fichas/{docId} {
      allow read: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || isPlantaRole() || isContabilidadStaff();
      allow create, delete: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      allow update: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || (isPlantaRole() && fichaUpdateEmpleadoOk());
    }

    match /fichas_sellos/{docId} {
      allow read: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || isPlantaRole() || isContabilidadStaff();
      allow create, delete: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      allow update: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || (isPlantaRole() && fichaUpdateEmpleadoOk());
    }

    match /fichas_abrigo_retractil/{docId} {
      allow read: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || isPlantaRole() || isContabilidadStaff();
      allow create, delete: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      allow update: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || (isPlantaRole() && fichaUpdateEmpleadoOk());
    }

    match /fichas_puertas_rapidas/{docId} {
      allow read: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || isPlantaRole() || isContabilidadStaff();
      allow create, delete: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      allow update: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || (isPlantaRole() && fichaUpdateEmpleadoOk());
    }

    match /fichas_puertas_seccionales/{docId} {
      allow read: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || isPlantaRole() || isContabilidadStaff();
      allow create, delete: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      allow update: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || (isPlantaRole() && fichaUpdateEmpleadoOk());
    }

    // Fichas básicas: órdenes sin ficha de fabricación (repuestos, semáforos,
    // lámparas, topes, rampas…). Mismos permisos que las demás fichas.
    match /fichas_generales/{docId} {
      allow read: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || isPlantaRole() || isContabilidadStaff();
      allow create, delete: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      allow update: if isAdmin() || (isActiveStaff() && hasRole('produccion')) || (isPlantaRole() && fichaUpdateEmpleadoOk());
    }

    // ─── Notificaciones (avisos de "ficha pasó a producción", etc.) ────────────
    match /notificaciones/{docId} {
      allow read: if isActiveStaff();
      allow create: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      // Cualquier staff activo puede marcarla como leída (solo el campo leidoPor).
      allow update: if isActiveStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidoPor']);
      allow delete: if isAdmin();
    }

    // Catálogo de insumos: lectura para producción, escritura solo admin
    match /division_insumos/{docId} {
      allow read: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      allow write: if isAdmin();
    }

    // Parámetros configurables (IVA, markup, rollo lona, etc.): escritura solo admin
    match /division_parametros/{docId} {
      allow read: if isAdmin() || (isActiveStaff() && hasRole('produccion'));
      allow write: if isAdmin();
    }

    // ─── Inventario: admin o usuario con rol "inventario" ─────────────────────
    match /inventario/{docId} {
      allow read, write: if isAdmin() || (isActiveStaff() && hasRole('inventario'));
    }

    match /inventario/{docId}/{subCol}/{subId} {
      allow read, write: if isAdmin() || (isActiveStaff() && hasRole('inventario'));
    }

    // El cuarto de materia prima es del almacenista (y de inventario/admin desde
    // la oficina). El rol "empleado" ya no entra: la sección no le aparece en la
    // app y aquí tampoco tiene lectura.
    match /inventario_items/{docId} {
      allow read: if isAlmacenStaff();
      // Crear y editar sí; borrar no: el material borrado se lleva por delante
      // el historial de movimientos que lo referencia.
      allow create, update: if isAlmacenStaff();
      allow delete: if isAdmin() || (isActiveStaff() && hasRole('inventario'));
    }

    match /inventario_proveedores/{docId} {
      allow read: if isAlmacenStaff();
      allow create, update: if isAlmacenStaff();
      allow delete: if isAdmin() || (isActiveStaff() && hasRole('inventario'));
    }

    // Un movimiento no se corrige ni se borra desde el almacén: si algo quedó
    // mal registrado, lo arregla inventario/admin desde el escritorio.
    match /inventario_movimientos/{docId} {
      allow read: if isAlmacenStaff();
      allow update, delete: if isAdmin() || (isActiveStaff() && hasRole('inventario'));
      allow create: if isAdmin() || (isActiveStaff() && hasRole('inventario')) || (
        isAlmacenistaRole() &&
        (request.resource.data.tipo == 'ingreso' || request.resource.data.tipo == 'salida') &&
        // Toda salida queda amarrada a la orden de producción que se la llevó.
        (request.resource.data.tipo != 'salida' || (
          request.resource.data.ordenProduccion is number && request.resource.data.ordenProduccion > 0
        )) &&
        // El precio solo entra con la factura de compra, nunca en una salida.
        (request.resource.data.tipo != 'salida' ||
          !('costoUnitario' in request.resource.data) ||
          request.resource.data.costoUnitario == 0)
      );
    }

    // ─── Contabilidad: facturación y cartera ──────────────────────────────────
    match /contabilidad_documentos/{docId} {
      allow read: if isContabilidadStaff();
      allow create, update: if isContabilidadStaff();
      allow delete: if isAdmin() || (isContabilidadStaff() && esImportado());
    }

    // Los abonos sí se corrigen y se borran: registrar un pago con el valor o
    // el banco equivocado es el error corriente, y dejarlo inmutable obligaría
    // a inventar un contra-abono.
    match /contabilidad_pagos/{docId} {
      allow read: if isContabilidadStaff();
      allow create, update, delete: if isContabilidadStaff();
    }

    match /contabilidad_saldos_iniciales/{docId} {
      allow read: if isContabilidadStaff();
      allow create, update, delete: if isContabilidadStaff();
    }

    // Tarifas de retención, IVA por defecto y bancos.
    match /contabilidad_config/{docId} {
      allow read: if isContabilidadStaff();
      allow write: if isContabilidadStaff();
    }

    // ─── Configuración de precios ──────────────────────────────────────────────
    match /pricingConfig/{docId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    match /configuracion/{docId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    // ─── Catálogo de productos ────────────────────────────────────────────────
    match /productos/{docId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    // ─── Catch-all: admin accede a todo; todo lo demás denegado ───────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
